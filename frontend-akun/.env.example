# Salin ke .env.local lalu sesuaikan. Hanya NEXT_PUBLIC_* yang terbaca browser: JANGAN taruh rahasia di sini.
# Alamat backend ExpressJS. Kosong = same-origin (mis. lewat rewrites/proxy).
NEXT_PUBLIC_API_BASE_URL=
# Awalan endpoint. Backend saat ini memakai /api; /api/v1 baru usulan (Kontrak bagian 10, K8).
NEXT_PUBLIC_API_PREFIX=/api
# Mock hanya untuk pengembangan. Build produksi menolak nilai true.
NEXT_PUBLIC_API_MOCK=false
